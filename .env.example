# AI Risk Blog — Environment Variables
# Copy this file to .env and fill in the values you want to use.
# All variables are OPTIONAL — the pipeline runs without any API keys
# using template-based summaries and a placeholder meme image.

# ─── Summarization (optional) ─────────────────────────────────────────────────
# If set, gpt-4o-mini is used to generate richer summaries and captions.
# Without this, deterministic keyword-based summaries are used (zero cost).
OPENAI_API_KEY=

# ─── Image Generation (optional) ──────────────────────────────────────────────
# URL to an OpenAI-compatible image generation endpoint (e.g. DALL·E).
# If not set, a local placeholder PNG is used instead.
IMAGE_API_URL=https://api.openai.com/v1/images/generations
IMAGE_API_KEY=

# Model to use for image generation (dall-e-2 is cheapest, dall-e-3 is higher quality).
IMAGE_MODEL=dall-e-2

# ─── Pipeline controls ─────────────────────────────────────────────────────────
# Maximum number of new posts to publish per run (default: 3).
# Lower to reduce costs; raise to catch up after a gap.
MAX_POSTS_PER_RUN=3
